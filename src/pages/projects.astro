---
import Base from "../layouts/Base.astro";
import { getProjects } from "../lib/github";
import { SITE } from "../config";

const projects = await getProjects();
---
<Base title="Projects" description="Things I've built, and what I'm working on now.">
  <h1 class="page-title">Projects</h1>
  <p class="page-intro">
    Things I've built, and what I'm working on now. The rest lives on <a href={SITE.links.github}>GitHub</a>.
  </p>

  <ul class="grid">
    {projects.map((p) => (
      <li class:list={["item", { linked: p.url }]}>
        <span class="kind">{p.kind}</span>
        <h2>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h2>
        {p.summary && <p class="summary">{p.summary}</p>}
        {(p.tags.length > 0 || p.stars > 0) && (
          <p class="meta">
            {p.tags.map((t) => <span>{t}</span>)}
            {p.stars > 0 && <span>★ {p.stars}</span>}
          </p>
        )}
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-intro a { color: var(--text); }
  .grid {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0 2.5rem;
  }
  .item {
    position: relative;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .kind { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); }
  h2 { font-size: 1.3rem; margin-top: 0.5rem; }
  h2 a { text-decoration: none; }
  /* make the whole item clickable */
  .linked h2 a::after { content: ""; position: absolute; inset: 0; }
  .linked:hover h2 { color: var(--accent); }
  .summary { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.98rem; line-height: 1.6; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: auto 0 0;
    padding-top: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
