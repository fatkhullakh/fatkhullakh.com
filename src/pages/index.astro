---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { getProjects } from "../lib/github";
import { SITE } from "../config";

const posts = (await getPosts()).slice(0, 5);
const featured = (await getProjects()).slice(0, 4);
---
<Base>
  <section class="hero">
    <h1>Hi, I'm {SITE.name}.</h1>
    <p class="nick">You can call me {SITE.nickname}.</p>
    <p class="typed">
      I write about <em data-typed data-phrases={JSON.stringify(SITE.typing)}>{SITE.typing[0]}</em><span class="caret" aria-hidden="true"></span>
    </p>
    <p class="lede">
      I'm a data engineer in {SITE.city}. I keep notes on what I learn at work, and I write up
      every interview I go through once it's over: what they asked, where I struggled, and what
      I'd prepare differently.
    </p>
    <div class="ctas">
      <a href="/writing" class="cmd">read the writing</a>
      <a href="/projects" class="cmd">see the projects</a>
    </div>
  </section>

  <section class="block">
    <h2 class="section-title">
      latest writing
      {posts.length > 0 && <a href="/writing">view all</a>}
    </h2>
    {posts.length > 0
      ? <PostList posts={posts} />
      : <p class="muted">The first essay is on its way.</p>}
  </section>

  <section class="block">
    <h2 class="section-title">
      projects
      <a href="/projects">view all</a>
    </h2>
    <ul class="projects">
      {featured.map((p) => (
        <li>
          {p.url ? <a href={p.url} class="pname">{p.name}</a> : <span class="pname">{p.name}</span>}
          <span class="kind">{p.kind}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // Types and deletes the phrases in the "I write about ..." line.
  const el = document.querySelector<HTMLElement>("[data-typed]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !still) {
    const phrases: string[] = JSON.parse(el.dataset.phrases || "[]");
    let i = 0;
    let n = phrases[0].length;
    let deleting = false;
    const step = () => {
      const word = phrases[i];
      n += deleting ? -1 : 1;
      el.textContent = word.slice(0, n);
      let wait = deleting ? 28 : 55;
      if (!deleting && n === word.length) { deleting = true; wait = 2400; }
      else if (deleting && n === 0) { deleting = false; i = (i + 1) % phrases.length; wait = 350; }
      setTimeout(step, wait);
    };
    deleting = true;
    setTimeout(step, 2600);
  }
</script>

<style>
  .hero {
    min-height: calc(100vh - 6.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 6rem;
  }
  h1 {
    font-size: clamp(2.8rem, 7.5vw, 5.4rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .nick {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1.1rem 0 0;
  }
  .typed {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    margin: 2.25rem 0 0;
    min-height: 2.6em;
  }
  .typed em { color: var(--text); }
  .caret {
    display: inline-block;
    width: 1px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .lede {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0.75rem 0 0;
    max-width: 33rem;
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 1.75rem; margin-top: 2.5rem; }
  .block + .block { margin-top: 4.5rem; }
  .projects { list-style: none; padding: 0; margin: 0; }
  .projects li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .projects li:first-child { border-top: 1px solid var(--line); }
  .pname { font-family: var(--serif); font-size: 1.3rem; text-decoration: none; }
  .kind { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); text-align: right; }
  @media (max-width: 900px) {
    .hero { min-height: 0; padding: 2rem 0 4rem; }
  }
</style>
