---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---
<Base title="About">
  <h1 class="page-title">About</h1>
  <div class="prose">
    <p>
      I'm {SITE.name}, a data engineer based in {SITE.city}. Most people call me {SITE.nickname}.
      I work mostly with Python, PySpark, SQL, Databricks, dbt and Airflow.
    </p>
    <p>
      This site is where I write things down properly: notes on what I learn, and honest
      write-ups of the interviews I go through, published after each process ends.
    </p>
    <p>
      Found a mistake, or want to talk? Email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SITE.links.linkedin && <span> or find me on <a href={SITE.links.linkedin}>LinkedIn</a></span>}.
    </p>
  </div>
</Base>

<style>
  .page-title { margin-bottom: 2rem; }
</style>
