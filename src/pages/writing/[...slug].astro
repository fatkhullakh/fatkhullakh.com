---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate, readingTime, type Post } from "../../lib/posts";
import { TAGS, SITE } from "../../config";
import Share from "../../components/Share.astro";
import Comments from "../../components/Comments.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const facts = [
  d.company && { label: "Company", value: d.company },
  d.role && { label: "Role", value: d.role },
  d.outcome && { label: "Outcome", value: d.outcome },
].filter(Boolean) as { label: string; value: string }[];
---
<Base title={d.title} description={d.description} type="article">
  <article>
    <header class="post-head">
      <a href="/writing" class="back-top">← all writing</a>
      <p class="meta">
        <a href={`/writing/tag/${d.tag}`}>{TAGS[d.tag].toLowerCase()}</a>
        <span>{formatDate(d.date)}</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      <Share title={d.title} url={new URL(`/writing/${post.id}`, SITE.url).href} />
      <Comments />
      <p class="back"><a href="/writing" class="cmd">← back to all writing</a></p>
    </footer>
  </article>
</Base>

<style>
  .post-head { padding: 0 0 2.5rem; border-bottom: 1px solid var(--line); margin-bottom: 2.75rem; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .meta a { color: var(--accent); text-decoration: none; }
  h1 { font-size: clamp(2.1rem, 5vw, 3rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.08; }
  .desc { font-size: 1.15rem; color: var(--muted); margin: 1.1rem 0 0; line-height: 1.55; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 2rem 0 0;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    background: var(--bg-raised);
    border-radius: 0 6px 6px 0;
  }
  .facts dt { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .facts dd { margin: 0.2rem 0 0; font-weight: 500; }
  .back-top {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2.25rem;
  }
  .back-top:hover { color: var(--accent); }
  .post-foot { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .back { margin-top: 3.5rem; }
</style>
