---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate, readingTime, type Post } from "../../lib/posts";
import { TAGS } from "../../config";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const facts = [
  d.company && { label: "Company", value: d.company },
  d.role && { label: "Role", value: d.role },
  d.outcome && { label: "Outcome", value: d.outcome },
].filter(Boolean) as { label: string; value: string }[];
---
<Base title={d.title} description={d.description} type="article">
  <article>
    <header class="post-head">
      <p class="meta muted">
        <a href={`/writing/tag/${d.tag}`}>{TAGS[d.tag]}</a>
        <span>{formatDate(d.date)}</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/writing">Back to all writing</a></p>
  </article>
</Base>

<style>
  .post-head { padding: 2rem 0 2.5rem; border-bottom: 1px solid var(--line); margin-bottom: 2.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.92rem; margin: 0 0 1rem; }
  .meta a { color: var(--accent); text-decoration: none; }
  h1 { font-size: clamp(2.1rem, 6vw, 3rem); letter-spacing: -0.02em; }
  .desc { font-family: var(--serif); font-size: 1.25rem; color: var(--muted); margin: 1rem 0 0; line-height: 1.45; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 1rem 1.15rem;
    background: var(--bg-raised);
    border-radius: 8px;
  }
  .facts dt { font-size: 0.82rem; color: var(--muted); }
  .facts dd { margin: 0.1rem 0 0; font-weight: 500; }
  .back { margin-top: 3.5rem; font-size: 0.95rem; }
</style>
