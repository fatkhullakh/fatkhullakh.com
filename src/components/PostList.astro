---
import { formatDate, type Post } from "../lib/posts";
import { TAGS } from "../config";

interface Props {
  posts: Post[];
  showTag?: boolean;
}
const { posts, showTag = true } = Astro.props;
---
<ul class="list">
  {posts.map((p) => (
    <li>
      <a href={`/writing/${p.id}`} class="row">
        <span class="main">
          <span class="title">
            {p.data.title}
            {p.data.draft && <span class="draft">draft</span>}
          </span>
          <span class="desc">{p.data.description}</span>
        </span>
        <span class="side">
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          {showTag && <span class="tag">{TAGS[p.data.tag].toLowerCase()}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  li:first-child .row { border-top: 1px solid var(--line); }
  .main { display: flex; flex-direction: column; gap: 0.3rem; }
  .title {
    font-size: 1.2rem;
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--text);
    transition: color 0.15s;
  }
  .row:hover .title { color: var(--accent); }
  .desc { color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    padding-top: 0.35rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tag { color: var(--accent); }
  .draft {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--accent-ink);
    background: var(--muted);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    margin-left: 0.5rem;
    vertical-align: 0.3em;
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 0.6rem; }
    .side { flex-direction: row; align-items: center; gap: 1rem; padding: 0; order: -1; }
  }
</style>
