---
// A dome medallion in the spirit of Samarkand and Bukhara ceilings,
// generated from geometry at build time. Purely decorative.
const C = 500;
const pt = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)].map((n) => n.toFixed(2)).join(" ");
};

// 32 pointed petals between two rings
const petals = Array.from({ length: 32 }, (_, i) => {
  const a = i * (360 / 32);
  return `M${pt(380, a)} Q${pt(430, a - 5.2)} ${pt(468, a)} Q${pt(430, a + 5.2)} ${pt(380, a)}Z`;
}).join(" ");

// 16-point star {16/6}
const star16 = (() => {
  const pts = Array.from({ length: 16 }, (_, i) => pt(370, i * 22.5));
  let d = "";
  for (let i = 0; i < 16; i++) d += `M${pts[i]} L${pts[(i + 6) % 16]} `;
  return d;
})();

// 24 teardrops in the middle band
const drops = Array.from({ length: 24 }, (_, i) => {
  const a = i * 15 + 7.5;
  return `M${pt(130, a)} Q${pt(200, a - 7)} ${pt(245, a)} Q${pt(200, a + 7)} ${pt(130, a)}Z`;
}).join(" ");

// 12-point star at the center
const star12 = (() => {
  const pts = Array.from({ length: 12 }, (_, i) => pt(118, i * 30));
  let d = "";
  for (let i = 0; i < 12; i++) d += `M${pts[i]} L${pts[(i + 5) % 12]} `;
  return d;
})();

const rays = Array.from({ length: 48 }, (_, i) => `M${pt(255, i * 7.5)} L${pt(300, i * 7.5)}`).join(" ");
const beads = Array.from({ length: 64 }, (_, i) => pt(320, i * 5.625).split(" "));
---
<svg class="rosette" viewBox="0 0 1000 1000" aria-hidden="true" fill="none" stroke="currentColor">
  <g stroke-width="1.1">
    <circle cx={C} cy={C} r="490" />
    <circle cx={C} cy={C} r="476" />
    <path d={petals} />
    <circle cx={C} cy={C} r="376" />
    <path d={star16} stroke-width="0.8" />
    {beads.map(([x, y]) => <circle cx={x} cy={y} r="4" />)}
    <circle cx={C} cy={C} r="300" />
    <path d={rays} stroke-width="0.8" />
    <circle cx={C} cy={C} r="252" />
    <path d={drops} />
    <circle cx={C} cy={C} r="124" />
    <path d={star12} stroke-width="0.9" />
    <circle cx={C} cy={C} r="34" />
    <circle cx={C} cy={C} r="12" />
  </g>
</svg>

<style>
  .rosette {
    position: absolute;
    top: 50%;
    right: -27rem;
    width: 58rem;
    height: 58rem;
    transform: translateY(-50%);
    color: var(--ornament);
    pointer-events: none;
    z-index: -1;
    animation: turn 400s linear infinite;
  }
  @keyframes turn {
    from { transform: translateY(-50%) rotate(0deg); }
    to { transform: translateY(-50%) rotate(360deg); }
  }
  @media (max-width: 900px) {
    .rosette { width: 32rem; height: 32rem; right: -17rem; top: 55%; }
  }
</style>
