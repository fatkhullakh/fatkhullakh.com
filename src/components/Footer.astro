---
import { SITE } from "../config";

const links = [
  { href: SITE.links.github, label: "GitHub" },
  { href: SITE.links.linkedin, label: "LinkedIn" },
  { href: SITE.links.telegram, label: "Telegram" },
  { href: SITE.email ? `mailto:${SITE.email}` : "", label: "Email" },
  { href: "/rss.xml", label: "RSS" },
].filter((l) => l.href);
---
<footer class="wrap">
  <div class="footer">
    <span>© {new Date().getFullYear()} {SITE.fullName}</span>
    <nav aria-label="Elsewhere">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
    margin-top: 5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }
  nav { display: flex; flex-wrap: wrap; gap: 1.1rem; }
  a { text-decoration: none; }
</style>
