---
import { TAGS } from "../config";

interface Props { active: string; counts: Record<string, number> }
const { active, counts } = Astro.props;
const items = [
  { key: "all", label: "all", href: "/writing" },
  ...Object.entries(TAGS).map(([key, label]) => ({
    key,
    label: label.toLowerCase(),
    href: `/writing/tag/${key}`,
  })),
];
---
<nav class="filter" aria-label="Filter by topic">
  {items.map((i) => (
    <a href={i.href} aria-current={i.key === active ? "page" : undefined}>
      {i.label}<span class="count">{counts[i.key] ?? 0}</span>
    </a>
  ))}
</nav>

<style>
  .filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem; }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.4rem 0.75rem;
    transition: color 0.15s, border-color 0.15s;
  }
  a:hover { color: var(--text); border-color: var(--muted); }
  a[aria-current="page"] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .count { font-size: 0.7rem; opacity: 0.7; }
</style>
