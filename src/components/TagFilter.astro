---
import { TAGS } from "../config";

interface Props { active: string }
const { active } = Astro.props;
const items = [
  { key: "all", label: "All", href: "/writing" },
  ...Object.entries(TAGS).map(([key, label]) => ({ key, label, href: `/writing/tag/${key}` })),
];
---
<nav class="filter" aria-label="Filter by topic">
  {items.map((i) => (
    <a href={i.href} aria-current={i.key === active ? "page" : undefined}>{i.label}</a>
  ))}
</nav>

<style>
  .filter { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  a {
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
  }
  a:hover { color: var(--text); border-color: var(--muted); }
  a[aria-current="page"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>
