---
// Likes (reactions) and comments, stored as GitHub Discussions via giscus.
// Readers sign in with GitHub to react or comment. Configure in src/config.ts.
import { SITE } from "../config";
const g = SITE.giscus;
const enabled = Boolean(g.repoId && g.categoryId);
---
{enabled && (
  <section class="comments" aria-label="Comments">
    <h2 class="section-title">likes and comments</h2>
    <div
      class="giscus-mount"
      data-repo={g.repo}
      data-repo-id={g.repoId}
      data-category={g.category}
      data-category-id={g.categoryId}
    ></div>
  </section>
)}

<script>
  const mount = document.querySelector<HTMLElement>(".giscus-mount");
  const themeFor = (t?: string) => (t === "light" ? "noborder_light" : "transparent_dark");

  if (mount) {
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    const attrs: Record<string, string> = {
      "data-repo": mount.dataset.repo!,
      "data-repo-id": mount.dataset.repoId!,
      "data-category": mount.dataset.category!,
      "data-category-id": mount.dataset.categoryId!,
      "data-mapping": "pathname",
      "data-strict": "1",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "top",
      "data-theme": themeFor(document.documentElement.dataset.theme),
      "data-lang": "en",
      "data-loading": "lazy",
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    mount.appendChild(s);

    // keep giscus in step with the light/dark switch
    document.addEventListener("themechange", ((e: CustomEvent<string>) => {
      const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: themeFor(e.detail) } } },
        "https://giscus.app",
      );
    }) as EventListener);
  }
</script>

<style>
  .comments { margin-top: 4rem; }
</style>
