---
// Eight-point star, the girih motif from Central Asian tilework.
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="mark">
  <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
    <rect x="5" y="5" width="14" height="14" />
    <rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)" />
  </g>
  <circle cx="12" cy="12" r="2" fill="currentColor" />
</svg>
<style>
  .mark { color: var(--accent); flex-shrink: 0; display: block; }
</style>
